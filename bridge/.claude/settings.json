{
  "$comment": "Session boundary for the bridge (plan.md 6.2). The session boundary is the permission boundary: this session can only write inside its own agent. contracts/ and plan.md are read here and written by the design session.",
  "permissions": {
    "deny": [
      "Write(microscope_agent/**)",
      "Edit(microscope_agent/**)",
      "Write(simulation_agent/**)",
      "Edit(simulation_agent/**)",
      "Write(librarian_agent/**)",
      "Edit(librarian_agent/**)",
      "Write(contracts/**)",
      "Edit(contracts/**)",
      "Write(plan.md)",
      "Edit(plan.md)",
      "Bash(python3*hardware*)",
      "Write(*/runs/**)",
      "Edit(*/runs/**)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/contracts/validate.py\" --quiet",
            "$comment": "the validator's exit code is the only truth (plan.md 8)"
          }
        ]
      }
    ]
  }
}
