{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "scope_approval.schema.json",
  "title": "scope_approval — an operating licence over a condition range (6.1)",
  "allOf": [
    {
      "$ref": "common.schema.json#/$defs/common_head"
    }
  ],
  "properties": {
    "card": {
      "const": "scope_approval"
    },
    "agent": {
      "$ref": "common.schema.json#/$defs/agent"
    },
    "config": {
      "type": "string",
      "description": "the one configuration this licence covers"
    },
    "range": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "common.schema.json#/$defs/interval"
      },
      "description": "must be a subset of the envelope; it can never exceed it (6.1, check 18)"
    },
    "devices": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "valid_until": {
      "type": "string",
      "format": "date-time",
      "description": "mandatory: no open-ended licence"
    },
    "max_runs": {
      "type": "integer",
      "minimum": 1,
      "description": "mandatory"
    },
    "runs_used": {
      "type": "integer",
      "minimum": 0
    },
    "calibration_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "the licence dies when any of these is superseded or expires"
    },
    "max_grade": {
      "const": "E3",
      "description": "a scope may only cover plans resting on E1-E3 (6.1)"
    },
    "voided": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "reason": {
          "enum": [
            "expired",
            "runs_exhausted",
            "calibration_changed",
            "deviation",
            "envelope_changed"
          ]
        },
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "evidence": {
          "type": "string"
        }
      },
      "required": [
        "reason",
        "at"
      ],
      "additionalProperties": false
    },
    "approved_by": {
      "type": "string",
      "minLength": 2
    },
    "approved_at": {
      "type": "string",
      "format": "date-time"
    },
    "note": {
      "type": "string"
    }
  },
  "required": [
    "agent",
    "config",
    "range",
    "devices",
    "valid_until",
    "max_runs",
    "runs_used",
    "max_grade",
    "approved_by",
    "approved_at"
  ],
  "unevaluatedProperties": false
}
