{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "capabilities.schema.json",
  "title": "capabilities — which configurations can produce which observables (4.5.3, 4.6.7)",
  "description": "Read by S3.0 to screen configurations and by the bridge to test answerability. On the microscope side each configuration corresponds to one entry in envelope/optical_paths.json: one table, two consumers.",
  "type": "object",
  "properties": {
    "schema_version": { "const": "0.1" },
    "agent": { "enum": ["microscope_agent", "simulation_agent"] },
    "status": {
      "enum": ["skeleton", "populated"],
      "description": "skeleton means the configuration list is not yet declared; S3.0 refuses rather than guessing"
    },
    "pending": { "type": "string", "description": "which open question fills this" },
    "configurations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "config": { "type": "string", "pattern": "^[a-z0-9_]+$" },
          "label": { "type": "string" },
          "optical_path": { "type": ["string", "null"] },
          "devices": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "observables": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "name": { "type": "string" },
                "definition": { "type": "string", "minLength": 20 },
                "units": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
              },
              "required": ["name", "definition", "units"],
              "additionalProperties": false
            }
          },
          "axes_applicable": {
            "type": "array",
            "items": { "enum": ["a1", "a2", "a3", "a4", "a5", "a6", "a7"] }
          }
        },
        "required": ["config", "devices", "observables"],
        "additionalProperties": false
      }
    }
  },
  "required": ["schema_version", "agent", "status", "configurations"],
  "additionalProperties": false
}
