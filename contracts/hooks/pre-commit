#!/bin/sh
# Refuse a commit that would put a failing tree into history (plan.md 8).
#
# The gate judges the tree the commit would create -- the index, unpacked --
# and not the working copy, so another session's unfinished file neither
# refuses this commit nor lets a broken one through. It runs the validator
# with --staged, which adds checks 35 and 41: one boundary per commit, and
# the committer's name (contracts/seats.json, six names, plan.md 6.2.1) owning
# that boundary. Then every rejected fixture must still be rejected.
#
# Commit through contracts/tools/seat_commit.py, which sets the committer from
# the registry. A check is deleted only when declared: the tool passes
# --removes-check N as SMA_REMOVES_CHECKS, and this hook refuses a commit that
# removes any other check HEAD has.
set -e
REPO=$(git rev-parse --show-toplevel)
cd "$REPO"

PY=""
for _c in python3 python; do
    if "$_c" -c 'import jsonschema, referencing' >/dev/null 2>&1; then PY="$_c"; break; fi
done
if [ -z "$PY" ] && command -v uv >/dev/null 2>&1 \
   && uv run --offline --no-project --python 3.12 --with jsonschema python -c 'import jsonschema, referencing' >/dev/null 2>&1; then
    PY="uv run --offline --no-project --python 3.12 --with jsonschema python"
fi
if [ -z "$PY" ]; then
    echo "pre-commit: no python on PATH imports jsonschema and referencing, and uv cannot supply them;" >&2
    echo "pre-commit: the gate would run without its schema check, so it does not run." >&2
    exit 1
fi
py() { $PY "$@"; }
export PYTHONUTF8=1

STAGED=$(git diff --cached --name-only)
if [ -z "$STAGED" ]; then
    exit 0
fi

# The identity being spent, as git will record it. GIT_COMMITTER_* beat
# user.* and a committer.* pinned in .git/config.worktree, which is in no tree.
IDENT=$(git var GIT_COMMITTER_IDENT 2>/dev/null | sed 's/ [0-9][0-9]* [-+][0-9][0-9]*$//')
echo "pre-commit: committing as ${IDENT:-an identity git would not name}"
WT=$(git rev-parse --git-path config.worktree 2>/dev/null)
if [ -n "$WT" ] && [ -f "$WT" ]; then
    PINNED=$(git config --file "$WT" committer.name 2>/dev/null || true)
    if [ -n "$PINNED" ]; then
        echo "            (.git/config.worktree pins '$PINNED'; GIT_COMMITTER_NAME overrides it)"
    fi
fi
echo "pre-commit: committing"
echo "$STAGED" | sed 's#^#  #'

# A check deleted by accident is usually a stale base: HEAD moved under an
# index built earlier. A check deleted on purpose is declared by number.
if echo "$STAGED" | grep -q '^contracts/validate\.py$'; then
    _H=$(mktemp) && _I=$(mktemp)
    git show HEAD:contracts/validate.py 2>/dev/null | sed -n 's/^def check_\([0-9]*\)_.*/\1/p' | sed 's/^0*//' | sort -u > "$_H"
    git show :contracts/validate.py                 | sed -n 's/^def check_\([0-9]*\)_.*/\1/p' | sed 's/^0*//' | sort -u > "$_I"
    GONE=$(comm -23 "$_H" "$_I" | tr '\n' ' ' | sed 's/ *$//')
    rm -f "$_H" "$_I"
    SAID=$(echo "${SMA_REMOVES_CHECKS:-}" | tr ' ' '\n' | sed 's/^0*//' | grep -v '^$' | sort -u | tr '\n' ' ' | sed 's/ *$//')
    GONE_SORTED=$(echo "$GONE" | tr ' ' '\n' | grep -v '^$' | sort -u | tr '\n' ' ' | sed 's/ *$//')
    if [ "$GONE_SORTED" != "$SAID" ]; then
        echo >&2
        echo "pre-commit: refused. This commit removes checks [${GONE_SORTED}] and declares [${SAID}]." >&2
        echo "            A check is deleted only when the commit says so, by number:" >&2
        echo "            contracts/tools/seat_commit.py --removes-check N. If you did not" >&2
        echo "            mean to delete one, HEAD moved under your index; rebuild it." >&2
        exit 1
    fi
    [ -n "$SAID" ] && echo "pre-commit: removes checks $SAID, as declared"
fi

DIRTY=$(git diff --name-only)
if [ -n "$DIRTY" ]; then
    echo "pre-commit: differs from what is being committed, and not checked"
    echo "$DIRTY" | sed 's#^#  #'
fi
echo

EXPORT=$(mktemp -d "${TMPDIR:-/tmp}/sma-pre-commit-XXXXXXXX")
trap 'rm -rf "$EXPORT"' EXIT HUP INT TERM
if ! git checkout-index -a -f --prefix="$EXPORT/"; then
    echo "pre-commit: refused. The index could not be unpacked, so there is nothing to check." >&2
    exit 1
fi
export SMA_GIT_REPO="$REPO"

echo "pre-commit: contracts"
OUT=$(py "$EXPORT/contracts/validate.py" --staged 2>&1) && STATUS=0 || STATUS=$?
if [ "$STATUS" -ne 0 ]; then
    echo "$OUT" | grep -E "FAIL|UNDECIDED" >&2 || true
    echo >&2
    echo "pre-commit: refused. The failures above are in the tree this commit" >&2
    echo "            would create, so they are this commit's." >&2
    exit 1
fi
# check 59 reads this phrase: keep it in step with what check 41 emits.
ATTRIB=$(echo "$OUT" | grep "carry no attribution:" || true)
if [ -n "$ATTRIB" ]; then
    echo >&2
    echo "pre-commit: this commit carries no attribution. It is allowed and is" >&2
    echo "            not checked -- no name owns these paths. Commit through" >&2
    echo "            contracts/tools/seat_commit.py so the record says who wrote it:" >&2
    echo "$ATTRIB" | sed 's#^#  #' >&2
fi

echo "pre-commit: the cards that must fail"
if ! py "$EXPORT/contracts/validate.py" --expect-fail "$EXPORT/contracts/examples/rejected" >/dev/null 2>&1; then
    echo >&2
    echo "pre-commit: refused. A card in contracts/examples/rejected/ stopped failing," >&2
    echo "            which means a check stopped working. Run:" >&2
    echo "            $PY contracts/validate.py --expect-fail contracts/examples/rejected" >&2
    exit 1
fi
exit 0
