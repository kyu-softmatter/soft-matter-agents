#!/bin/sh
# Refuse a push whose commits cross a session boundary, or whose README has
# stopped naming what the repository contains.
#
# It also compared a generated English plan.md against a Korean plan_ko.md
# until 2026-09-20. That arrangement ended -- plan.md is the record again and
# the Korean left version control -- so the branch was removed. What it did
# in its last hours is the reason it is worth naming here: it printed "plan.md
# carries no generated-from header, so the rendering is not generated yet"
# on eight pushes, describing a future that had been cancelled, and the seat
# reading it read past it every time. A gate that narrates a state nobody is
# in teaches its reader to skip its output, which costs the lines that do
# matter.
#
# WHY A SECOND GATE AT ALL. pre-commit judges one commit and can be skipped
# with --no-verify, which leaves no trace. Its own comment names the remedy --
# "the durable catch is running check 35 over a pushed range after the fact"
# -- and after the fact is the part this replaces: a boundary crossing found
# in pushed history is an archaeology problem, and found here it is an
# unpushed commit. Nothing new is enforced. What changes is when.
#
# WHY IT REFUSES RATHER THAN UPDATES. The ask was that the documents go out
# current, and updating them is the obvious reading. A hook cannot do it:
# deciding what prose should say needs a model, and P0 puts no model in a
# gate. Deterministic code can only compare and refuse. So this says "these
# are out of step, here is the command" and stops. That constraint is what
# made the two-document arrangement unworkable in the first place -- a hash
# bound the pair and no generator existed, so every edit to the record was
# two hand-edits and a recomputed header.
#
# WHAT IT DOES NOT LOOK AT, said here because a gate that implies more than it
# checks is worse than no gate:
#   - whether README's prose is true. It checks that every top-level entry is
#     named and that relative links resolve. A README that names everything
#     and describes it wrongly passes.
#   - the content checks (1-34, 36-65) on the pushed tip. pre-commit judged
#     each commit as it was made; re-judging them here would refuse a push for
#     a failure that is already in history and cannot be fixed by not pushing.
#     They are reported below and do not refuse.
#
# Install: git config core.hooksPath contracts/hooks   (same setting as pre-commit)
#
# `git push --no-verify` bypasses this and leaves no trace that it did, exactly
# as --no-verify does for the commit gate. If you use it, say so where the next
# reader will look. A hook makes the right thing easy, not the wrong thing
# impossible.

set -e

REMOTE_NAME="$1"
REPO=$(git rev-parse --show-toplevel)
cd "$REPO"

if ! command -v python3 >/dev/null 2>&1; then
    echo "pre-push: python3 not found; cannot run the gate" >&2
    exit 1
fi

ZERO='^0*$'
REFUSED=0

while read -r LOCAL_REF LOCAL_OID REMOTE_REF REMOTE_OID; do
    [ -n "$LOCAL_OID" ] || continue
    if echo "$LOCAL_OID" | grep -qE "$ZERO"; then
        echo "pre-push: $REMOTE_REF is being deleted; nothing to check"
        continue
    fi

    # The range. A ref the remote already has bounds itself. A new ref does
    # not, so take the oldest commit no remote-tracking branch holds and stop
    # one before it; at the root there is no "one before", and then the whole
    # ref is checked and the line below says so rather than checking less and
    # staying quiet.
    if echo "$REMOTE_OID" | grep -qE "$ZERO"; then
        OLDEST=$(git rev-list "$LOCAL_OID" --not --remotes="$REMOTE_NAME" 2>/dev/null | tail -1 || true)
        if [ -n "$OLDEST" ] && git rev-parse -q --verify "${OLDEST}^" >/dev/null 2>&1; then
            RANGE="${OLDEST}^..${LOCAL_OID}"
        else
            RANGE="$LOCAL_OID"
            echo "pre-push: $LOCAL_REF is new to $REMOTE_NAME and nothing bounds it, so its whole"
            echo "          history is being checked"
        fi
    else
        RANGE="${REMOTE_OID}..${LOCAL_OID}"
    fi

    if [ -z "$(git rev-list "$RANGE" 2>/dev/null)" ]; then
        echo "pre-push: $LOCAL_REF has nothing the remote lacks"
        continue
    fi

    echo "pre-push: $LOCAL_REF  $RANGE  ($(git rev-list --count "$RANGE") commits)"

    # Judge the pushed tip's own copy of the validator, not the working copy.
    # Several sessions share one checkout, so the working copy is nobody's
    # commit -- the same reason pre-commit unpacks the index instead.
    EXPORT=$(mktemp -d "${TMPDIR:-/tmp}/sma-pre-push-XXXXXXXX")
    git archive "$LOCAL_OID" | tar -x -C "$EXPORT"

    # Checks 35 and 41 read the repository rather than the export, which has no
    # .git. Both already iterate a range commit by commit -- 35 says so in its
    # own docstring, because diffing the endpoints would aggregate two seats'
    # work into one apparent crossing -- so one invocation covers every commit.
    export SMA_GIT_REPO="$REPO"
    OUT=$(python3 "$EXPORT/contracts/validate.py" --commit-range "$RANGE" 2>&1 || true)

    BOUNDARY=$(echo "$OUT" | grep -E '^ *check (35|41) +FAIL' || true)
    if [ -n "$BOUNDARY" ]; then
        echo >&2
        echo "$BOUNDARY" >&2
        echo >&2
        echo "pre-push: refused. A commit in this range crosses a session boundary or" >&2
        echo "          cannot be attributed (6.2). It is in history already, so fix it" >&2
        echo "          by adding the commit that corrects the record -- not by" >&2
        echo "          rewriting what other sessions have built on." >&2
        REFUSED=1
    fi

    OTHER=$(echo "$OUT" | grep -E '^ *check +[0-9]+ +FAIL' | grep -vE '^ *check (35|41) ' || true)
    if [ -n "$OTHER" ]; then
        echo "pre-push: the tip also fails these, and this hook does not refuse them --"
        echo "          pre-commit judged each commit as it was made, and not pushing"
        echo "          does not fix a failure already in history:"
        echo "$OTHER" | sed 's#^#  #'
    fi

    # (2) was the English rendering against the Korean original. Removed
    # 2026-09-20 with the two-document arrangement it enforced: plan.md is
    # the record again and plan_ko.md left version control, so there is no
    # pair to compare. Its last act was to print, on eight pushes, that the
    # rendering was "not generated yet" and that it would "enforce from the
    # first header on" -- a future that had been cancelled. The number is
    # left as a gap rather than closed up, so that this paragraph has
    # somewhere to sit. (3) was removed earlier and the gap is the same kind.

    # (4) README, only what can be decided without reading it.
    README=$(git show "$LOCAL_OID:README.md" 2>/dev/null || true)
    if [ -z "$README" ]; then
        echo >&2
        echo "pre-push: refused. The pushed tree has no README.md." >&2
        REFUSED=1
    else
        UNNAMED=""
        for TOP in $(git ls-tree --name-only "$LOCAL_OID"); do
            case "$TOP" in .*) continue ;; esac
            echo "$README" | grep -qF "$TOP" || UNNAMED="$UNNAMED $TOP"
        done
        if [ -n "$UNNAMED" ]; then
            echo >&2
            echo "pre-push: refused. README.md names none of:$UNNAMED" >&2
            echo "          A top-level entry the front door does not mention is one a" >&2
            echo "          reader has no route to. This is the whole of what can be said" >&2
            echo "          deterministically about a README being current." >&2
            REFUSED=1
        fi
        DANGLING=""
        for LINK in $(echo "$README" | grep -oE '\]\([^)]+\)' | sed 's/^](//;s/)$//'); do
            case "$LINK" in http://*|https://*|mailto:*|\#*) continue ;; esac
            TARGET=$(echo "$LINK" | sed 's/#.*$//;s/:[0-9]*$//')
            [ -n "$TARGET" ] || continue
            git cat-file -e "$LOCAL_OID:$TARGET" 2>/dev/null \
                || DANGLING="$DANGLING $TARGET"
        done
        if [ -n "$DANGLING" ]; then
            echo >&2
            echo "pre-push: refused. README.md links resolve to nothing in the pushed" >&2
            echo "          tree:$DANGLING" >&2
            REFUSED=1
        fi
    fi

    rm -rf "$EXPORT"
done

if [ "$REFUSED" -ne 0 ]; then
    exit 1
fi

echo "pre-push: boundary and README all clear"
exit 0
