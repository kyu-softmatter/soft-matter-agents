      ],
      "falsifier": "a measured diameter, or the product's specification sheet, replaces it",
      "gap_ref": "bead_diameter_absent"
    },
    {
      "rationale_id": "a_bleach_radius",
      "statement": "A 3 um bleach disc, chosen from Stage 1 as the size at which the estimator's bleach, frame and window bounds are all comfortable (bleach up to 50 ms, frames up to 100 ms, a 6 s record). It is this agent's pick until the microscope plan states the disc it can make.",
      "numbers": [
        "bleach_radius"
      ],
      "falsifier": "the disc radius in the microscope plan the bridge carries replaces it",
      "gap_ref": "bleach_radius_absent"
    },
    {
      "rationale_id": "a_chamber_depth",
      "statement": "A 10 um deep chamber, a round guess. It sets how many beads one curve counts and nothing else.",
      "numbers": [
        "chamber_depth"
      ],
      "falsifier": "the chamber the microscope side uses replaces it",
      "gap_ref": "sample_chamber_depth_absent"
    },
    {
      "rationale_id": "a_bleach_rate",
      "statement": "Beads inside the disc go dark at fifty per second under the patterning light: one bleaching time inside the runs' bleach length, so the dip is of order one half. It sets how deep the dip is and nothing about how fast the disc refills.",
      "numbers": [
        "bleach_rate"
      ],
      "falsifier": "a measured bleaching rate under the patterning illumination replaces it",
      "gap_ref": "bleaching_rate_absent"
    },
    {
      "rationale_id": "a_bead_levels",
      "statement": "Ten to a thousand beads per curve, in half-decade steps, spans the counts at which one curve goes from noise to a reading; the levels are a design of the scatter question and not a claim about the sample.",
      "numbers": [
        "beads_in_disc_10",
        "beads_in_disc_30",
        "beads_in_disc_100",
        "beads_in_disc_300",
        "beads_in_disc_1000"
      ],
      "falsifier": "the bead count the microscope plan's disc and dilution give replaces the levels by one point",
      "gap_ref": "tracer_volume_fraction_absent"
    },
    {
      "rationale_id": "a_pre_frames",
      "gap_ref": "pre_bleach_frames_absent",
